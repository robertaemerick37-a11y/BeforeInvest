PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-64-character-hex-key
PROFILE_ENCRYPTION_KEY=replace-with-a-different-random-64-character-hex-key
CORS_ALLOWED_ORIGINS=

# Use a separate Turso database for local development and production.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=replace-with-a-database-token

# Required to deliver admin sign-in codes
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=Marsvest <security@example.com>

# Production deployment only
PUBLIC_ORIGIN=https://your-domain.example
TRUST_PROXY_HOPS=1
